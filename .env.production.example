# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# For high-performance, high-traffic setup
# ========================================

APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false  # IMPORTANT: Set to false in production
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Phnom_Penh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error  # Only log errors in production

# ========================================
# DATABASE - Use MySQL/PostgreSQL for better performance
# ========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# For SQLite (NOT recommended for production with high traffic)
# DB_CONNECTION=sqlite

# ========================================
# CACHE - Use Redis for best performance
# Install Redis: https://redis.io/download
# ========================================
CACHE_DRIVER=redis  # redis (best), file (good), database (slow)
CACHE_PREFIX=attendance_

# ========================================
# SESSION - Use Redis for best performance with multiple users
# ========================================
SESSION_DRIVER=redis  # redis (best), file (good), database (slow)
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ========================================
# QUEUE - Use Redis for async jobs
# ========================================
QUEUE_CONNECTION=redis  # redis (best), database (ok), sync (slow)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ========================================
# REDIS Configuration
# Required if using redis for cache/session/queue
# ========================================
REDIS_CLIENT=phpredis  # phpredis is faster than predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ========================================
# MAIL Configuration
# ========================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# PERFORMANCE TUNING
# ========================================

# OPcache (configure in php.ini for best results)
# opcache.enable=1
# opcache.memory_consumption=256
# opcache.max_accelerated_files=20000
# opcache.validate_timestamps=0

# PHP Memory Limit (configure in php.ini)
# memory_limit=512M

# Max Execution Time (configure in php.ini)
# max_execution_time=300

# ========================================
# AWS S3 (Optional - for file storage)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ========================================
# ADDITIONAL PERFORMANCE SETTINGS
# ========================================

# Enable query caching (if using MySQL)
# Add to my.cnf or my.ini:
# query_cache_type=1
# query_cache_size=64M

# Connection pooling
DB_POOL_MIN=10
DB_POOL_MAX=100

# ========================================
# MONITORING (Optional)
# ========================================
# TELESCOPE_ENABLED=false  # Disable in production
# DEBUGBAR_ENABLED=false   # Disable in production
